<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>FactuTrust.Infrastructure</RootNamespace>
    <AssemblyName>FactuTrust.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FactuTrust.Domain\FactuTrust.Domain.csproj" />
    <ProjectReference Include="..\FactuTrust.Application\FactuTrust.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Entity Framework Core with SQL Server -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- ASP.NET Core Identity -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.1" />

    <!-- PDF Generation (Open Source) -->
    <PackageReference Include="QuestPDF" Version="2024.3.0" />
    <!-- Tamponnage de formulaires officiels préimprimés (QuestPDF ne sait pas importer un PDF existant) -->
    <PackageReference Include="PdfSharp" Version="6.2.1" />
    <PackageReference Include="Humanizer" Version="2.14.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />

    <!-- XML Processing -->
    <PackageReference Include="System.Xml.XDocument" Version="4.3.0" />

    <!-- Cryptography (Open Source) -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />

    <!-- TOTP (Time-based One-Time Password) for platform admin 2FA — Lot B2 -->
    <PackageReference Include="Otp.NET" Version="1.4.0" />

    <!-- Email — Lot C2 : SMTP via System.Net.Mail (intégré .NET, pas de NuGet externe).
         Templating fait maison via SimpleTemplateRenderer. La migration vers MailKit
         pourra être faite en production quand une version stable sans CVE sera disponible. -->

    <!-- Hangfire.Core — utilisé par EmailService pour enqueue les jobs (job server est dans API) -->
    <PackageReference Include="Hangfire.Core" Version="1.8.14" />

    <!-- Excel/CSV Import (Open Source) -->
    <PackageReference Include="CsvHelper" Version="31.0.2" />
    <PackageReference Include="ClosedXML" Version="0.102.2" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />

    <!-- Data Protection -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.1" />

    <!-- Configuration (for design-time factories) -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />

    <!-- HTTP Client for external API calls -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />

    <!-- PDF text extraction (read-only) for AI document import -->
    <PackageReference Include="PdfPig" Version="0.1.10" />

    <!-- PDF page rendering to PNG (for OCR fallback and vision LLM input) -->
    <PackageReference Include="PDFtoImage" Version="4.1.1" />

    <!-- OCR (Tesseract 5) for scanned PDFs and image attachments -->
    <PackageReference Include="Tesseract" Version="5.2.0" />

    <!-- Image preprocessing before OCR (import facture photo) -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />

    <!-- DOCX text extraction for AI document import.
         Version pinned to 2.20.0 to remain compatible with ClosedXML 0.102.x
         (which constrains DocumentFormat.OpenXml < 3.0.0). -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="2.20.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\TejSchemas\*.xsd" />
    <EmbeddedResource Include="Services\Forecasting\Calendar\Resources\*.json" />
    <!-- Formulaires officiels DGI : gabarit vierge préimprimé, carte des coordonnées de
         tamponnage et police embarquée (l'image runtime n'installe aucune police système). -->
    <EmbeddedResource Include="Resources\OfficialForms\*.pdf" />
    <EmbeddedResource Include="Resources\OfficialForms\*.json" />
    <EmbeddedResource Include="Resources\OfficialForms\Fonts\Lato-Regular.ttf" />
    <EmbeddedResource Include="Fonts\NotoNaskhArabic-Regular.ttf" />
    <EmbeddedResource Include="Resources\Accounting\*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tesseract OCR language data : copié à côté du binaire pour Tesseract.
         Si le dossier est vide (fichiers .traineddata non déposés), le service OCR
         est gracieusement désactivé sans casser le reste de l'application. -->
    <None Include="Resources\Tessdata\*.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\Tessdata\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
