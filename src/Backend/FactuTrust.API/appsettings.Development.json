{
  "Localization": {
    "ArabicMessagesEnabled": true
  },
  "ExternalApis": {
    "Unsplash": {
      "AccessKey": "",
      "BaseUrl": "https://api.unsplash.com"
    },
    "GoogleCustomSearch": {
      "ApiKey": "",
      "SearchEngineId": ""
    }
  },
  "ConnectionStrings": {
    "MasterConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FactuTrust_Master;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "DefaultTenantConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FactuTrust_Tenant_Default;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Ollama": {
    "EnableMutationTools": true,
    "InvoiceImportModel": "qwen2.5:7b-instruct",
    "InvoiceImportVisionModel": "gemma3:4b",
    "_commentBankStatementImportVisionModel": "Modèle vision des relevés nommé explicitement (le poste n'a pas forcément GLM-OCR : sans lui, l'import de relevés annonce « GLM-OCR indisponible », comportement à tester en développement). Ne pas laisser hériter de gemma3:4b.",
    "BankStatementImportVisionModel": "hf.co/ggml-org/GLM-OCR-GGUF:Q8_0",
    "InvoiceImportVisionMinOcrChars": 80,
    "InvoiceImportVisionOnEmptyOcr": true,
    "InvoiceImportVisionOnImages": true,
    "ImportMaxOutputTokens": 1536,
    "ImportLlmTimeoutSeconds": 180,
    "TimeoutSeconds": 360,
    "KeepAliveEnabled": true
  },
  "TenantMigrations": {
    "ApplyOnStartup": false,
    "ApplyOnlyToMissingMigrations": true
  },
  "TenantProvisioning": {
    "Strategy": "Migrate",
    "TemplateDatabaseName": "FactuTrust_Tenant_Template",
    "CleanupOrphanDatabasesOnFailure": true
  },
  "Accounting": {
    "PayrollTreasuryLinkEnabled": true,
    "PayrollEmployeeAuxiliaryEnabled": true,
    "PayrollCnssRemittanceEnabled": true,
    "AccountingHealthEnabled": true,
    "AccountingAuditDashboardEnabled": true,
    "AccountingAuditPersistenceEnabled": true,
    "AccountingAuditSchedulingEnabled": true,
    "MonthlyDeclarationOfficialFormEnabled": true,
    "CashDeskVatEnabled": true,
    "BankStatementAiPostingEnabled": true,
    "BankStatementAiForAllDocumentsEnabled": true,
    "BankStatementImport": {
      "AiOnlyReadingEnabled": true,
      "AiBalanceMismatchAsWarning": true,
      "VisionReadingEnabled": true,
      "VisionTextFallbackEnabled": false,
      "VisionSendTextLayer": false,
      "AiWorkerCount": 1,
      "DocStrangeEnabled": true
    }
  },
  "Features": {
    "AutoCashFromInvoicePayment": true,
    "AutoCashFromSupplierPayment": true,
    "PosRegisterSessions": true,
    "FirmGovernance": {
      "EnableFirmInternalPayroll": true,
      "AutoProvisionPayrollOnCollaboratorCreate": true
    }
  },
  "AiExport": {
    "Validation": {
      "Enabled": true,
      "ThrowOnError": true,
      "MaxIssuesLogged": 50
    },
    "PowerPoint": {
      "ExtendedThemeLibraryEnabled": true,
      "TemplateHybridEnabled": true,
      "HybridThemeMinId": 3,
      "RequireAttributionSlide": true
    }
  },
  "Forecasting": {
    "Enabled": true,
    "BackgroundRecomputeEnabled": true,
    "PromotionDetectorEnabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}