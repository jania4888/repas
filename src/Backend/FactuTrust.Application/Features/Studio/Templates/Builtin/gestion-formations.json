{
  "system": {
    "displayName": "Gestion des formations",
    "icon": "graduation-cap",
    "description": "Organisation des formations : catalogue, sessions planifiées et inscriptions des participants.",
    "onboarding": [
      "Vérifiez le catalogue de formations préchargé",
      "Planifiez une session",
      "Inscrivez un participant"
    ],
    "menu": { "label": "Formations", "icon": "graduation-cap" }
  },
  "entities": [
    {
      "ref": "formations",
      "displayName": "Formation",
      "displayNamePlural": "Formations",
      "icon": "graduation-cap",
      "isReferenceData": true,
      "fields": [
        { "key": "intitule", "label": "Intitulé", "type": "text", "required": true, "unique": true },
        { "key": "theme", "label": "Thème", "type": "select",
          "options": [
            { "value": "management", "label": "Management" },
            { "value": "technique", "label": "Technique" },
            { "value": "securite", "label": "Sécurité" },
            { "value": "langues", "label": "Langues" }
          ]
        },
        { "key": "duree_jours", "label": "Durée (jours)", "type": "number" }
      ],
      "form": {
        "sections": [
          { "title": "Formation", "fields": [ "intitule", "theme", "duree_jours" ] }
        ]
      }
    },
    {
      "ref": "employes",
      "displayName": "Employé",
      "displayNamePlural": "Employés",
      "icon": "users",
      "isReferenceData": true,
      "fields": [
        { "key": "nom", "label": "Nom", "type": "text", "required": true },
        { "key": "prenom", "label": "Prénom", "type": "text" },
        { "key": "service", "label": "Service", "type": "select",
          "options": [
            { "value": "rh", "label": "RH" },
            { "value": "technique", "label": "Technique" },
            { "value": "commercial", "label": "Commercial" },
            { "value": "direction", "label": "Direction" }
          ]
        },
        { "key": "e_mail", "label": "E-mail", "type": "text" }
      ],
      "form": {
        "sections": [
          { "title": "Employé", "fields": [
            { "field": "nom", "width": "half" },
            { "field": "prenom", "width": "half" },
            "service",
            "e_mail"
          ] }
        ]
      }
    },
    {
      "ref": "sessions",
      "displayName": "Session",
      "displayNamePlural": "Sessions",
      "icon": "calendar",
      "fields": [
        { "key": "formation", "label": "Formation", "type": "relation", "relationTo": "formations", "required": true },
        { "key": "formateur", "label": "Formateur", "type": "text" },
        { "key": "date_debut", "label": "Date de début", "type": "date", "required": true },
        { "key": "date_fin", "label": "Date de fin", "type": "date" },
        { "key": "lieu", "label": "Lieu", "type": "text" },
        { "key": "capacite", "label": "Capacité", "type": "number" },
        { "key": "statut", "label": "Statut", "type": "select",
          "options": [
            { "value": "planifiee", "label": "Planifiée" },
            { "value": "confirmee", "label": "Confirmée" },
            { "value": "terminee", "label": "Terminée" },
            { "value": "annulee", "label": "Annulée" }
          ]
        }
      ],
      "form": {
        "sections": [
          { "title": "Session", "fields": [
            "formation",
            "formateur",
            { "field": "date_debut", "width": "half" },
            { "field": "date_fin", "width": "half" },
            { "field": "lieu", "width": "half" },
            { "field": "capacite", "width": "half" },
            "statut"
          ] }
        ]
      },
      "report": {
        "displayName": "Sessions planifiées",
        "fields": [ "formation", "formateur", "date_debut", "lieu", "capacite" ],
        "sort": [ { "field": "date_debut", "dir": "asc" } ]
      },
      "views": [
        {
          "name": "Par statut",
          "mode": "kanban",
          "groupBy": "statut",
          "title": "lieu",
          "columns": [ "formation", "date_debut", "lieu" ]
        },
        {
          "name": "Calendrier",
          "mode": "calendar",
          "start": "date_debut",
          "end": "date_fin",
          "title": "lieu",
          "columns": [ "formation", "formateur" ],
          "isDefault": true
        }
      ]
    },
    {
      "ref": "inscriptions",
      "displayName": "Inscription",
      "displayNamePlural": "Inscriptions",
      "icon": "user-plus",
      "workflow": {
        "statusFieldKey": "statut",
        "states": [
          { "key": "inscrit", "label": "Inscrit", "color": "blue" },
          { "key": "present", "label": "Présent", "color": "orange" },
          { "key": "certifie", "label": "Certifié", "color": "green" }
        ],
        "initialState": "inscrit",
        "transitions": [
          { "from": "inscrit", "to": "present", "label": "Marquer présent" },
          { "from": "present", "to": "certifie", "label": "Certifier" }
        ]
      },
      "fields": [
        { "key": "session", "label": "Session", "type": "relation", "relationTo": "sessions", "required": true },
        { "key": "participant", "label": "Participant", "type": "relation", "relationTo": "employes", "required": true },
        { "key": "e_mail", "label": "E-mail", "type": "text" },
        { "key": "statut", "label": "Statut", "type": "select", "required": true,
          "options": [
            { "value": "inscrit", "label": "Inscrit" },
            { "value": "present", "label": "Présent" },
            { "value": "certifie", "label": "Certifié" }
          ]
        }
      ],
      "form": {
        "sections": [
          { "title": "Inscription", "fields": [ "session", "participant", "e_mail", "statut" ] }
        ]
      }
    }
  ],
  "relations": [
    { "kind": "many_to_many", "from": "employes", "to": "formations", "label": "Participants", "junctionName": "Participations" }
  ],
  "seed": [
    { "entityRef": "formations", "records": [
      { "intitule": "Gestion de projet", "theme": "management", "duree_jours": 3 },
      { "intitule": "Sécurité au travail", "theme": "securite", "duree_jours": 1 },
      { "intitule": "Anglais professionnel", "theme": "langues", "duree_jours": 10 }
    ] }
  ]
}
