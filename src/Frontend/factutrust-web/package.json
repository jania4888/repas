{
  "name": "factutrust-web",
  "version": "1.0.0",
  "description": "InstaFact - Plateforme de gestion commerciale intelligente",
  "scripts": {
    "ng": "ng",
    "start": "set NG_BUILD_MAX_WORKERS=1&& set GOMAXPROCS=1&& ng serve --no-hmr --poll=2000",
    "start:low-mem": "set NG_BUILD_MAX_WORKERS=1&& set GOMAXPROCS=1&& ng serve --configuration=lean",
    "start:hmr": "set NG_BUILD_MAX_WORKERS=1&& set GOMAXPROCS=2&& ng serve --hmr --poll=2000",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "set CHOKIDAR_USEPOLLING=1 && ng build --watch --poll=2000 --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "docs:screenshots": "playwright test capture-screenshots --project=chromium",
    "docs:partnership-video": "playwright test partnership-expert-comptable-video --config=playwright.partnership-video.config.ts --project=chromium",
    "test:e2e:selenium": "ts-node node_modules/jasmine/bin/jasmine.js e2e/registration.selenium.spec.ts",
    "install:playwright": "npx playwright install",
    "theme:import": "node ../../../scripts/import-pluto-theme.js",
    "theme:import-chain": "node ../../../scripts/import-chain-theme.js",
    "lint": "ng lint",
    "virtual-street:build-glbs": "node scripts/generate-facade-glbs.mjs",
    "virtual-street:build-textures": "node scripts/generate-facade-textures.mjs",
    "virtual-street:build-assets": "npm run virtual-street:build-textures && npm run virtual-street:build-glbs",
    "vendor:draco": "node scripts/copy-draco-decoder-to-assets.mjs",
    "validate:facade-glb": "node scripts/validate-facade-glbs.mjs",
    "quality:gate": "npm run virtual-street:build-assets && npm run validate:facade-glb && npm run build:prod",
    "test:street-catalog": "node scripts/test-street-catalog.mjs",
    "validate:street-catalog": "node scripts/validate-street-catalog.mjs",
    "test:e2e:street": "playwright test e2e/playwright.virtual-street.spec.ts --project=chromium",
    "quality:gate:street-catalog": "npm run validate:facade-glb && npm run validate:street-catalog",
    "check:landing-copy": "node scripts/check-landing-hardcoded-text.mjs",
    "check:landing-css": "node scripts/check-landing-physical-css.mjs",
    "test:landing": "npm run check:landing-copy && npm run check:landing-css",
    "check:erp-copy": "node scripts/check-erp-hardcoded-text.mjs",
    "check:erp-css": "node scripts/check-erp-physical-css.mjs",
    "test:erp-i18n": "npm run check:erp-copy && npm run check:erp-css",
    "i18n:build": "node scripts/i18n/build-runtime-translations.mjs",
    "i18n:ids": "node scripts/i18n/gate/check-ids.mjs",
    "i18n:tm": "node scripts/i18n/tm-lookup.mjs",
    "i18n:restore-whitespace": "node scripts/i18n/verify/restore-fr-whitespace.mjs",
    "i18n:values": "node scripts/i18n/gate/check-value-messages.mjs",
    "i18n:missing": "node scripts/i18n/dump-missing.mjs",
    "i18n:apply-batch": "node scripts/i18n/apply-translation-batch.mjs",
    "i18n:gate": "npm run i18n:ids && npm run i18n:values && node scripts/i18n/build-runtime-translations.mjs --strict && npm run i18n:parity:template && npm run i18n:parity:ts",
    "i18n:extract": "node scripts/i18n/extract.mjs",
    "i18n:parity:template": "node scripts/i18n/verify/template-fr-parity.mjs",
    "i18n:parity:ts": "node scripts/i18n/verify/ts-fr-parity.mjs",
    "i18n:export-review": "node scripts/i18n/export-review.mjs",
    "i18n:inventory": "node scripts/i18n/inventory-gaps.mjs",
    "i18n:check": "node scripts/i18n/check-translations.mjs --allow-fr-fallback",
    "i18n:no-label-logic": "node scripts/i18n/check-no-label-logic.mjs",
    "i18n:pluto-rtl": "node scripts/i18n/build-pluto-rtl.mjs",
    "i18n:backend-labels": "node scripts/i18n/generate-backend-display-labels.mjs",
    "prestart": "npm run i18n:build",
    "pretest": "npm run i18n:build",
    "prebuild": "npm run i18n:build",
    "prebuild:prod": "npm run i18n:build",
    "i18n:codemod:test": "node scripts/i18n/codemod/mark-templates.fixture.test.mjs",
    "i18n:codemod:check": "node scripts/i18n/codemod/mark-templates.mjs src/app/shared/components --check",
    "i18n:codemod:assign": "node scripts/i18n/codemod/assign-i18n-ids.mjs src/app/features && node scripts/i18n/codemod/assign-i18n-ids.mjs src/app/shared",
    "i18n:codemod:mark": "node scripts/i18n/codemod/mark-templates.mjs src/app/features && node scripts/i18n/codemod/mark-templates.mjs src/app/shared && node scripts/i18n/codemod/mark-templates.mjs src/app/core/layout",
    "i18n:codemod:mark-ast": "node scripts/i18n/codemod/mark-templates-ast.mjs src/app/features && node scripts/i18n/codemod/mark-templates-ast.mjs src/app/shared && node scripts/i18n/codemod/mark-templates-ast.mjs src/app/core/layout",
    "i18n:codemod:mark-ast:check": "node scripts/i18n/codemod/mark-templates-ast.mjs src/app/shared/components --check",
    "i18n:apply-phrases": "node scripts/i18n/apply-phrase-map.mjs",
    "i18n:verify-phase9": "node scripts/i18n/verify-phase9.mjs",
    "i18n:wave:v1": "node scripts/i18n/check-translations.mjs --scope=core --wave=v1 --allow-fr-fallback",
    "i18n:wave:v2": "node scripts/i18n/check-translations.mjs --scope=auth --wave=v2",
    "i18n:wave:v3": "node scripts/i18n/check-translations.mjs --scope=dashboard --wave=v3 --allow-fr-fallback",
    "i18n:wave:v4": "node scripts/i18n/check-translations.mjs --scope=invoices --wave=v4 --allow-fr-fallback",
    "i18n:wave:v5": "node scripts/i18n/check-translations.mjs --scope=stock --wave=v5 --allow-fr-fallback",
    "i18n:wave:v6": "node scripts/i18n/check-translations.mjs --scope=payroll --wave=v6 --allow-fr-fallback",
    "i18n:wave:v7": "node scripts/i18n/check-translations.mjs --scope=accounting --wave=v7 --allow-fr-fallback"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/localize": "19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@lucide/angular": "^1.17.0",
    "@ng-bootstrap/ng-bootstrap": "^18.0.0",
    "@popperjs/core": "^2.11.8",
    "@primeuix/themes": "^1.2.5",
    "@types/three": "^0.161.2",
    "bootstrap": "^5.3.8",
    "camera-controls": "^2.8.3",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.12",
    "driver.js": "^1.3.6",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "marked": "^15.0.0",
    "ngx-markdown": "^19.1.1",
    "primeicons": "^7.0.0",
    "primeng": "^19.1.4",
    "rxjs": "~7.8.0",
    "three": "^0.161.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.25",
    "@playwright/test": "^1.57.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.0.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jasmine": "^5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.49",
    "postcss-rtlcss": "^5.4.0",
    "selenium-webdriver": "^4.15.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.0",
    "typescript": "~5.7.2"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
