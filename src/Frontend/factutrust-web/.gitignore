# Procedurally regenerated PBR texture sets. Run `npm run virtual-street:build-textures`
# in CI or before `ng build` to materialize them. Keep them out of git so the
# baseline repo stays small and the textures stay reproducible.
src/assets/virtual-street/textures/

# Playwright test output (traces, screenshots, videos, last-run metadata).
# Regenerated on every e2e run; must not be versioned.
test-results/
playwright-report/
junit.xml
e2e/test-results/

# i18n : catalogue runtime régénéré à chaque build (prestart/prebuild/pretest → i18n:build)
src/app/core/i18n/erp-i18n-manifest.generated.ts
src/assets/i18n/messages.ar.json
src/assets/i18n/messages.ar.*.json

# i18n : rapports et références de parité recalculés (seules les approbations sont versionnées)
scripts/i18n/reports/
e2e/baselines/fr-static/*
!e2e/baselines/fr-static/approved.json

# Exports de relecture native (régénérés par npm run i18n:export-review)
scripts/i18n/review/
