# =============================================================================
# FactuTrust — variables d'environnement Docker (deploy/.env)
# Copier vers deploy/.env et adapter avant le premier lancement :
#   cp deploy/.env.example deploy/.env
#   bash deploy/scripts/init-secrets.sh
#
# ORDRE IMPOSÉ : init-secrets.sh DOIT tourner AVANT le premier `docker compose up`.
# Le compose monte ./certs/dataprotection.pfx en bind ; si le fichier n'existe pas,
# Docker crée un RÉPERTOIRE vide à sa place et l'API lève au démarrage
# (X509Certificate2 sur un répertoire).
# =============================================================================

# --- Domaine (documentation / scripts / libellés Traefik) ---
FACTUTRUST_DOMAIN=votre-domaine.tn

# --- SQL Server ---
# Politique MSSQL : majuscule, minuscule, chiffre, symbole, 8+ caractères
MSSQL_SA_PASSWORD=ChangeMe!Str0ng_Sql_Password
# Developer = gratuit mais NON LICENCIÉ pour la production (recette/démo uniquement).
# Express   = gratuit et utilisable en production, MAIS : 10 Go par base, ~1410 Mo de
#             pool mémoire pour l'INSTANCE ENTIÈRE (partagé par tous les dossiers) et
#             4 cœurs max. Le pool est le vrai plafond, pas les 10 Go.
# Standard  = licence payante, seule option dimensionnée pour du multi-tenant réel.
MSSQL_PID=Express

# --- JWT (obligatoire, >= 32 octets) — généré par init-secrets.sh ---
JwtSettings__SecretKey=

# --- Signature électronique des factures (obligatoire, >= 32 octets) ---
# Généré par init-secrets.sh. SANS CETTE CLÉ L'API NE DÉMARRE PAS :
# Program.cs lève InvalidOperationException avant builder.Build().
# Voir docs/developer/secrets-configuration.md (rotation, clés compromises).
SignatureSettings__SecretKey=

# --- DataProtection (Linux/Docker obligatoire) ---
# Le trousseau est persisté DANS LA BASE MASTER (PersistKeysToDbContext) ; ce
# certificat ne fait que le chiffrer au repos. L'ensemble récupérable est donc :
#   sauvegarde de FactuTrust_Master + ce PFX + ce mot de passe.
# Les trois sont inséparables : l'un sans les autres = chaînes de connexion tenant,
# secrets TOTP et clés IA définitivement illisibles.
DataProtection__CertificatePath=/app/certs/dataprotection.pfx
DataProtection__CertificatePassword=
DATAPROTECTION_CERT_HOST_PATH=./certs/dataprotection.pfx

# --- CORS & URLs publiques (domaine unique) ---
# ATTENTION : découpé sur ',' SANS Trim() côté API. Pas d'espace après la virgule,
# jamais vide. « https://a.tn, https://b.tn » enregistre " https://b.tn" qui ne
# correspondra jamais.
AllowedOrigins=https://votre-domaine.tn,https://www.votre-domaine.tn
App__FrontendBaseUrl=https://votre-domaine.tn
# --- OpenRouter (optionnel) ---
OpenRouter__HttpReferer=https://votre-domaine.tn

# --- Modal Kimi 3 (optionnel, URL HTTPS …/v1 — pas de secrets ici) ---
# Modal__DefaultBaseUrl=https://votre-workspace--ep-kimi-k3-server.us-west.modal.direct/v1
# Modal__DefaultModelId=moonshotai/Kimi-K3
# Modal__TimeoutSeconds=300

# --- Pont Cursor SDK ---
# L'image API embarque Node 20 et n'installe pas @cursor/sdk (qui exige Node >= 22.13).
# Le pont échoue en silence (capturé + avertissement) ; on le coupe explicitement.
CursorSdk__Enabled=false

# --- Bootstrap premier admin plateforme (backoffice /admin/) ---
# Le semeur est idempotent-SKIP : une fois l'utilisateur créé, il ne réapplique
# JAMAIS le mot de passe. Après le premier login et le changement de mot de passe,
# VIDER cette variable et recréer l'API — sinon elle reste un secret en clair et périmé.
Bootstrap__PlatformAdmin__Email=admin@votre-domaine.tn
Bootstrap__PlatformAdmin__Password=

# --- Provisionnement des dossiers (tenants) ---
# TemplateClone (défaut du produit) restaure un .bak pré-migré : rapide, mais il exige
# que le chemin du .bak soit visible À LA FOIS de l'API (File.Exists) et de SQL Server
# (BACKUP/RESTORE TO DISK). Le volume nommé `tenant-provisioning` du compose monte le
# même chemin dans les deux conteneurs, ce qui rend les deux options viables.
#   Migrate       = CREATE DATABASE + 178 migrations EF (plusieurs minutes par dossier).
#   TemplateClone = restauration du template (quelques secondes).
# Au premier déploiement on reste sur Migrate, le temps de VÉRIFIER que le job
# hebdomadaire `tenant-template-maintenance` passe au vert (il appelle
# EnsureTenantTemplateAsync SANS regarder cette stratégie, et relance l'exception).
TenantProvisioning__Strategy=Migrate
TenantProvisioning__TemplateBackupPath=/var/opt/mssql/provisioning/tenant-template.bak
TenantProvisioning__DataFileDirectory=/var/opt/mssql/data

# --- Migrations tenant (production : contrôlé via backoffice) ---
TenantMigrations__ApplyOnStartup=false
TenantMigrations__ApplyOnlyToMissingMigrations=true

# --- Email SMTP (Hostinger exemple) ---
# OBLIGATOIRE en production avec de vrais clients : sans SMTP, la réinitialisation de
# mot de passe et la vérification d'e-mail passent en « mode capture » (lignes
# EmailMessage en statut Skipped, AUCUN envoi). Un utilisateur qui perd son mot de
# passe est définitivement bloqué.
Smtp__Enabled=true
Smtp__Host=smtp.hostinger.com
Smtp__Port=587
Smtp__UseSsl=true
Smtp__Username=noreply@votre-domaine.tn
Smtp__Password=
Smtp__FromEmail=noreply@votre-domaine.tn
Smtp__FromName=InstaFact

# --- Vitrine publique / anti-bot Cloudflare Turnstile ---
# Features:Storefront:Enabled=true et OrderSubmissionRequiresCaptcha=true par défaut.
# Sans secret, StorefrontCaptchaValidator REFUSE TOUTE commande publique sans même
# contacter Cloudflare (fail-closed volontaire). Deux issues, à choisir :
#   1) fournir le secret + l'hôte exact du widget (comparaison stricte, pas de suffixe) ;
#   2) couper la vitrine : Features__Storefront__Enabled=false
# Voir docs/runbooks/storefront-turnstile.md
# Features__Storefront__TurnstileSecretKey=
# Features__Storefront__TurnstileAllowedHostnames__0=votre-domaine.tn
# Features__Storefront__Enabled=false

# --- Canaux WhatsApp (désactivé phase 1) ---
# L'image API est construite avec PUPPETEER_SKIP_DOWNLOAD=1 : pas de Chromium.
# Activer ce canal exige d'ajouter Chromium et ses dépendances à l'image.
Channels__Enabled=false
Channels__WhatsAppEnabled=false

# --- Ollama (inférence CPU seule sur ce VPS : pas de GPU) ---
# Modèles attendus par l'application : qwen2.5:3b-instruct (défaut),
# qwen2.5:7b-instruct (import de facture), gemma3:4b (vision).
#
# MAX_LOADED_MODELS=2 et non 1 : l'assistant et le modèle d'import sont deux modèles
# DIFFÉRENTS. À 1, chaque import de facture évince l'assistant, puis le message de chat
# suivant évince le modèle d'import — un va-et-vient permanent. Mesuré en production le
# 21/09/2026 : charger qwen2.5:7b-instruct coûte 15,4 s, soit 95 % du temps de réponse.
# À 2, les deux cohabitent (5,5 + 1,6 = 7,1 Go, conteneur limité à 12 Go) et le
# rechargement tombe à 0,00 s — vérifié.
# Ne monter au-delà qu'après avoir vérifié la marge : chaque modèle résident consomme sa
# taille en RAM, et le plafond du conteneur est `mem_limit` dans docker-compose.vps.yml.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1

# --- Ports exposés sur l'hôte ---
# Ignorés quand on déploie derrière Traefik (deploy/docker-compose.vps.yml remet
# `ports` à zéro : Nginx ne publie plus rien et n'est joignable que par Traefik).
HTTP_PORT=80
HTTPS_PORT=443

# --- Frontal Traefik (uniquement avec deploy/docker-compose.vps.yml) ---
# Valeurs relevées sur le VPS Hostinger « Docker and Traefik » (template d'août 2026).
# À REVÉRIFIER sur un autre hôte : cat /docker/traefik/docker-compose.yml
# Le template tourne en `network_mode: host` : il n'y a AUCUN réseau Traefik à rejoindre,
# et donc pas de TRAEFIK_NETWORK. Il redirige déjà http->https globalement, donc pas de
# TRAEFIK_HTTP_ENTRYPOINT non plus.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Sous-réseau du pont `factutrust-net` — seul autorisé à déclarer l'IP cliente réelle.
# Traefik étant en mode host, l'adresse source vue par Nginx est celle de l'hôte sur ce
# pont. À relever APRÈS le premier `up` :
#   docker network inspect factutrust_factutrust-net #     --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# NE JAMAIS mettre 0.0.0.0/0 : n'importe qui pourrait alors usurper son IP et
# contourner la limitation de débit sur /api/auth/login.
TRUSTED_PROXY_CIDR=

# --- Observabilité optionnelle ---
Seq__Enabled=false
Seq__ServerUrl=http://seq:5341
Seq__ApiKey=
